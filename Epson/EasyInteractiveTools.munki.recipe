<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Comment</key>
	<string>Created with Recipe Robot v2.5.0 (https://github.com/homebysix/recipe-robot)</string>
	<key>Description</key>
	<string>Downloads the latest version of Easy Interactive Tools and imports it into Munki.</string>
	<key>Identifier</key>
	<string>com.github.macbr00ke.munki.EasyInteractiveTools</string>
	<key>Input</key>
	<dict>
		<key>MUNKI_REPO_SUBDIR</key>
		<string>Apps/Epson</string>
		<key>NAME</key>
		<string>EasyInteractiveTools</string>
		<key>pkginfo</key>
		<dict>
			<key>blocking_applications</key>
			<array>
				<string>Easy Interactive Tools.app</string>
				<string>Easy Interactive Tools Agent.app</string>
				<string>Easy Interactive Tools Uninstaller.app</string>
				<string>Easy Interactive Tools SSManager.app</string>
				<string>Epson EWF Converter.app</string>
			</array>
			<key>catalogs</key>
			<array>
				<string>testing</string>
			</array>
			<category>
			<string>Utilities</string>
			<key>description</key>
			<string>Easy Interactive Tools is an annotation software that allows you to use the BrightLink interactive pen to write or draw on the projection surface.</string>
			<key>developer</key>
			<string>Seiko Epson</string>
			<key>display_name</key>
			<string>Easy Interactive Tools</string>
			<key>name</key>
			<string>%NAME%</string>
			<key>unattended_install</key>
			<true/>
		</dict>
	</dict>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>ParentRecipe</key>
	<string>com.github.macbr00ke.download.EasyInteractiveTools</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>pkg_path</key>
				<string>%pathname%</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
			</dict>
			<key>Processor</key>
			<string>MunkiImporter</string>
		</dict>
	</array>
</dict>
</plist>
